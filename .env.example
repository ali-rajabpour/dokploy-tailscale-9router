# Set these in Dokploy's Environment tab, not in a file on the server.

# Reusable, non-ephemeral, tagged tag:nine-router. Consumed once on first run;
# after that the node identity lives in the tailscale-state volume.
TS_AUTHKEY=tskey-auth-REPLACE-ME

# openssl rand -hex 32
JWT_SECRET=REPLACE-ME

# Bootstrap password for the dashboard. 9router defaults this to 123456 when
# unset. Once you set a password in the UI it is bcrypt-hashed into SQLite
# and takes precedence over this value.
INITIAL_PASSWORD=REPLACE-ME
